# PostgreSQL connection string (Supabase: Project Settings > Database > Connection string)
DATABASE_URL=postgres://postgres@localhost:5432/hsim_portal
# Long random string (>= 32 chars) used to sign session cookies. Generate: openssl rand -base64 48
SESSION_SECRET=
# Used only by `npm run db:seed` / `npm run admin:create`
ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Timezone used for "today" (default Asia/Kolkata)
APP_TIMEZONE=Asia/Kolkata
